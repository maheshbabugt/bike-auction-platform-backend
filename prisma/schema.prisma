generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  ADMIN
}

enum AuctionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  CNG
}

enum BikeCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(BUYER)

  bids            Bid[]
  createdBikes    Bike[]     @relation("BikeCreatedBy")
  createdAuctions Auction[]  @relation("AuctionCreatedBy")
  wonAuctions     Auction[]  @relation("AuctionWinner")
  auditLogs       AuditLog[] @relation("AuditLogActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bike {
  id                 String        @id @default(uuid()) @db.Uuid
  brand              String
  model              String
  year               Int
  registrationNumber String        @unique
  kmsDriven          Int
  fuelType           FuelType
  condition          BikeCondition
  basePrice          Decimal       @db.Decimal(12, 2)
  imageUrl           String?
  description        String?
  createdById        String        @db.Uuid

  createdBy User      @relation("BikeCreatedBy", fields: [createdById], references: [id])
  auctions  Auction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Auction {
  id                String        @id @default(uuid()) @db.Uuid
  bikeId            String        @db.Uuid
  startingPrice     Decimal       @db.Decimal(12, 2)
  currentHighestBid Decimal       @default(0) @db.Decimal(12, 2)
  minimumIncrement  Decimal       @db.Decimal(12, 2)
  startTime         DateTime
  endTime           DateTime
  status            AuctionStatus @default(SCHEDULED)
  winnerUserId      String?       @db.Uuid
  createdById       String        @db.Uuid

  bike      Bike   @relation(fields: [bikeId], references: [id])
  winner    User?  @relation("AuctionWinner", fields: [winnerUserId], references: [id])
  createdBy User   @relation("AuctionCreatedBy", fields: [createdById], references: [id])
  bids      Bid[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startTime])
  @@index([endTime])
  @@index([bikeId])
}

model Bid {
  id        String   @id @default(uuid()) @db.Uuid
  auctionId String   @db.Uuid
  userId    String   @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([auctionId])
  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id          String  @id @default(uuid()) @db.Uuid
  actorUserId String? @db.Uuid
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([entityType])
}
